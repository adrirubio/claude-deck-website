---
import Base from './Base.astro'
import '../styles/site.css'
interface Props { title: string; description?: string; current?: '/' | '/how-it-works/' | '/quick-tour/' | '/technical-information/' }
const { title, description, current } = Astro.props
const NAV = [['/', 'Home'], ['/how-it-works/', 'How it works'], ['/quick-tour/', 'Quick tour'], ['/technical-information/', 'Technical information']] as const
---
<Base title={title} description={description}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="brand" href="/">Deck</a>
    <nav aria-label="Main">
      {NAV.map(([href, label]) => <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer wrap">
    <a class="brand" href="/">Deck</a>
    <nav aria-label="Footer">
      {NAV.slice(1).map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
  </footer>
</Base>
