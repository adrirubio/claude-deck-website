---
import Base from './Base.astro'
import '../styles/site.css'
interface Props { title: string; description?: string; current?: '/' | '/how-it-works/' | '/technical-information/' }
const { title, description, current } = Astro.props
const NAV = [['/', 'Home'], ['/how-it-works/', 'How it works'], ['/technical-information/', 'Technical information']] as const
---
<Base title={title} description={description}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label="Deck, home">Deck<span class="cursor" aria-hidden="true"></span></a>
      <nav aria-label="Main">
        {NAV.map(([href, label]) => <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="btn btn-sm" href="/how-it-works/">See how it works</a>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label="Deck, home">Deck<span class="cursor" aria-hidden="true"></span></a>
      <nav aria-label="Footer">
        {NAV.slice(1).map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
    </div>
  </footer>
</Base>
