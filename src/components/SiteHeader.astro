---
// Shared site header, ported from the approved v7d mockup.
// The compact logo is brand artwork, not a product mention: the first
// mention in each page's copy must still be the full Albiex Synth City,
// with Synth City after that (website-and-docs.md section 4.7).
interface Props {
  current?: 'how' | 'technical';
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Albiex Synth City — home">
      <img src="/brand/albiex-logo-compact.svg" alt="Albiex Synth City" height="44" />
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <a href="/how-it-works/" aria-current={current === 'how' ? 'page' : undefined}>How it works</a>
      <a href="/technical-information/" aria-current={current === 'technical' ? 'page' : undefined}>Technical information</a>
      <a href="/docs/">Documentation</a>
      <a class="nav-gh" href="https://github.com/albiexai/synth-city">Open source on GitHub</a>
    </nav>
    <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <a class="pill" href="https://github.com/albiexai/synth-city">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      Open source
    </a>
  </div>
</header>

<script>
  // Mobile menu, kept per page as in the mockup (website-and-docs.md 4.2).
  const header = document.querySelector('header.site-header');
  const menu = document.querySelector('.menu');
  if (header && menu) {
    const setMenu = (open: boolean) => {
      header.classList.toggle('open', open);
      menu.setAttribute('aria-expanded', String(open));
      menu.textContent = open ? 'Close' : 'Menu';
    };
    menu.addEventListener('click', () => setMenu(!header.classList.contains('open')));
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('open')) {
        setMenu(false);
        (menu as HTMLElement).focus();
      }
    });
  }
</script>
