---
import Page from '../../layouts/Page.astro'
import Shot from '../../components/Shot.astro'
import repositories from '../../assets/tour/repositories.png'
import teams from '../../assets/tour/teams.png'
import overview from '../../assets/tour/overview.png'
import workActive from '../../assets/tour/work-active.png'
import workReview from '../../assets/tour/work-review.png'
import workMerged from '../../assets/tour/work-merged.png'
// Copy: content/copy/quick-tour.md
const STOPS = [
  { title: 'Your features connect to a team', text: 'Deck connects the features you mark ready to the team you choose.', src: repositories,
    caption: 'Repositories, with example data: three connections; new work is paused on two.',
    alt: 'The Repositories screen with example data, listing three connections and whether each is taking in new work.' },
  { title: 'Choose who is on each team', text: 'Each team has a roster you prepare: its AI Leader, agent owners and AI reviewers, each with their own tools and models.', src: teams,
    caption: 'A team roster, with example data: its AI Leader and team members.',
    alt: "The Teams screen with example data, showing one team's roster, its named AI Leader, and its members." },
  { title: 'See what needs you', text: 'One overview puts what needs you first, then how every team is doing.', src: overview,
    caption: 'The Overview, with example data: what needs you comes first.',
    alt: 'The Overview screen with example data, showing what needs the Director, campaign progress, and a summary for each team.' },
  { title: 'Work in progress', text: 'Each feature gets its own AI team, working at its own pace. Work shows who is assigned and what is waiting.', src: workActive,
    caption: 'Work, with example data: assigned features and a feature waiting for an owner.',
    alt: 'The Work screen lists example features, their states, and their assigned owners. One queued feature has no owner yet.' },
  { title: 'When work waits for a person', text: 'An AI reviewer checks work they did not build. Your rules may ask for your review too.', src: workReview,
    caption: "Waiting for human review, with example data: under this team's rules, this item waits for a person.",
    alt: 'The Work screen with example data, showing an item whose state says it is waiting for human review.' },
  { title: 'Finished work, back in GitHub', text: "After the required reviews and checks, work can merge under your project's rules. You decide when it is ready to publish.", src: workMerged,
    caption: 'Work, with example data: a merged item shown with the All filter.',
    alt: 'The Work screen with example data, showing a merged item in the mixed-state All view.' },
]
---
<Page title="Deck — Quick tour" description="Six short stops to see what Deck looks like, and what you would do in it." current="/quick-tour/">
  <section class="wrap intro">
    <h1>Quick tour</h1>
    <p class="lede">Six short stops to see what Deck looks like, and what you would do in it.</p>
    <p>You, the Director, write your features in GitHub and mark them ready. These pictures show different example items inside Deck.</p>
  </section>

  <h2 class="sr-only">The six stops</h2>
  <ol class="wrap stops" aria-label="The six stops">
    {STOPS.map((s, i) => (
      <li class="pair">
        <div><h3><span class="n">{i + 1}.</span> {s.title}</h3><p>{s.text}</p></div>
        <Shot src={s.src} alt={s.alt} caption={s.caption} />
      </li>
    ))}
  </ol>

  <section class="block wrap" aria-labelledby="share-h">
    <h2 id="share-h">Share the tour</h2>
    <p>Send this tour to a colleague:</p>
    <p class="share"><a href="/quick-tour/">"Worth a look: Deck — your features, built and checked by AI teams."</a></p>
    <p>Prefer to watch? A short video of Deck in action will join this page later.</p>
  </section>

  <section class="block wrap" aria-labelledby="next-h">
    <h2 id="next-h">Next</h2>
    <p>Want the full story? Read How it works. Setting up? Try Technical information.</p>
    <div class="actions"><a class="btn" href="/how-it-works/">How it works</a><a class="quiet" href="/technical-information/">Technical information</a></div>
  </section>
</Page>

<style>
  .intro { padding-top: 24px }
  .stops { list-style: none; margin-top: 16px }
  .n { color: var(--ai-text) }
  .share { font-family: "Instrument Serif", serif; font-size: 28px; line-height: 1.2; max-width: 30ch }
  .share a { text-decoration-color: var(--human); text-decoration-thickness: 2px; text-underline-offset: 5px }
</style>
