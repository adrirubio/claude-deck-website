---
import Base from '../../../layouts/Base.astro'
import OutsideScene from '../../../scenes/outside/OutsideScene'
---
<Base title="Deck hero scene (draft)">
  <main>
    <header style="max-width:1240px;margin:0 auto;padding:40px 40px 0">
      <h1 style="font-size:40px;margin:0">The hero version</h1>
      <p style="color:var(--muted);margin:6px 0 0">Plays on its own when the page opens. Draft, not linked from the site.</p>
    </header>
    <section aria-label="The factory from outside">
      <OutsideScene client:load play="auto" />
    </section>
  </main>
</Base>
