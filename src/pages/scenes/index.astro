---
import Base from '../../layouts/Base.astro'
import OutsideScene from '../../scenes/outside/OutsideScene'
---
<Base title="Deck scenes (draft)">
  <main>
    <header style="max-width:1240px;margin:0 auto;padding:40px 40px 0">
      <h1 style="font-size:40px;margin:0">Scenes for review</h1>
      <p style="color:var(--muted);margin:6px 0 0">Scroll to play each scene. Draft, not linked from the site. The hero version, which plays on its own, is at <a href="/scenes/hero/">/scenes/hero/</a>.</p>
    </header>
    <section aria-label="The factory from outside">
      <OutsideScene client:visible />
    </section>
    <div style="height:60vh"></div>
  </main>
</Base>
