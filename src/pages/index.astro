---
import Page from '../layouts/Page.astro'
import OutsideScene from '../scenes/outside/OutsideScene'
// Copy: content/copy/home.md
---
<Page title="Deck — Scale product velocity with self-directing AI teams." description="Choose what to build. Let your AI teams get to work." current="/">
  <section class="hero wrap">
    <div class="hero-text">
      <h1>Scale product velocity with self-directing AI teams.</h1>
      <div>
        <p class="lede">Choose what to build. Let your AI teams get to work.</p>
        <div class="actions">
          <a class="btn" href="/how-it-works/">See how it works</a>
        </div>
      </div>
    </div>
    <div class="hero-art">
      <OutsideScene client:load label="Ready features flow from GitHub into Deck and its AI teams. Finished work returns to GitHub. You and your AI assistants supervise from outside the factory." />
    </div>
  </section>

  <section class="block wrap" aria-labelledby="yours-h">
    <h2 id="yours-h">What stays yours</h2>
    <div class="yours">
      <p>You, the Director, choose the features and who builds them.</p>
      <p>You supervise the factory with your AI assistants.</p>
      <p>You decide whether the results meet your goals.</p>
    </div>
  </section>

  <section class="block wrap closing">
    <p class="lede">Ready to watch your features become finished products? See how it works.</p>
    <div class="actions"><a class="btn" href="/how-it-works/">See how it works</a></div>
  </section>
</Page>

<style>
  /* The heading, then the scene under it at full width: beside the heading, its labels are too small to read. */
  .hero { padding-top: 16px; padding-bottom: 24px }
  .hero-text { display: grid; grid-template-columns: 7fr 5fr; gap: 16px 48px; align-items: end }
  .hero-text h1 { margin: 0 }
  .hero-text .lede { margin-bottom: 18px }
  .hero-art { margin-top: 32px }
  .hero-art :global(.scene) { min-height: auto; padding: 0 }
  .closing { text-align: left }
  @media (max-width: 900px) { .hero-text { grid-template-columns: 1fr } }
</style>
